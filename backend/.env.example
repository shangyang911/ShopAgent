DATABASE_URL=mysql+pymysql://<USER>:<PASSWORD>@<HOST>:3306/<DATABASE>?charset=utf8mb4
AUTH_COOKIE_SECURE=false

# 高德 Web 服务 Key 仅后端使用；jscode 安全密钥配置在 Nginx 代理中。
AMAP_WEB_KEY=YOUR_AMAP_WEB_SERVICE_KEY
AMAP_SERVICE_PROXY_URL=http://127.0.0.1:8080/_AMapService

# 门店/仓库发货坐标（高德 GCJ-02，经度在前、纬度在后）
AMAP_SHIPPING_ORIGIN_LONGITUDE=114.514976
AMAP_SHIPPING_ORIGIN_LATITUDE=38.042007

# Agent 智能客服：仅配置在后端，不要使用 VITE_ 前缀。
DASHSCOPE_API_KEY=
DASHSCOPE_REGION=cn-beijing
AGENT_MODEL=qwen-plus
AGENT_ASR_MODEL=fun-asr-realtime
AGENT_TTS_MODEL=cosyvoice-v3-flash
AGENT_TTS_VOICE=longanyang
AGENT_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# 若所选模型要求业务空间专属域名，填写控制台的业务空间 ID。
DASHSCOPE_WORKSPACE_ID=
# 后续建好知识库再填；未配置时不编造售后政策。
BAILIAN_KNOWLEDGE_BASE_ID=
# 需要覆盖地域服务地址时才设置以下变量：
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# DASHSCOPE_WS_URL=wss://<WorkspaceId>.cn-beijing.maas.aliyuncs.com/api-ws/v1/inference
# BAILIAN_RAG_URL=https://<WorkspaceId>.cn-beijing.maas.aliyuncs.com/api/v1/indices/rag/index/retrieve

# 快递100物流查询（二期）；凭证只在后端使用。未填写时发货/高德功能仍可运行。
KD100_CUSTOMER=
KD100_KEY=
# 自动查询默认关闭；启用后每单至少间隔30分钟。
LOGISTICS_AUTO_SYNC=false
LOGISTICS_SYNC_INTERVAL_MINUTES=30
# 自定义公司名到快递100编码的映射，例如 {"门店合作快递":"shunfeng"}
KD100_CARRIER_CODES={}

# 电子面单 V2（三期），独立于物流查询账号；凭证只留在后端。
KD100_LABEL_KEY=
KD100_LABEL_SECRET=
# 真实寄件人资料，示例：{"name":"仓库联系人","mobile":"手机号","printAddr":"完整发货地址"}
KD100_LABEL_SENDER={}
# 按快递编码配置账号/模板；其他网点参数见 docs/SHIPPING-phase3.md。
# 例：{"shunfeng":{"partnerId":"月结账号","partnerKey":"密码","tempId":"模板ID","payType":"MONTHLY"}}
KD100_LABEL_ACCOUNTS={}
