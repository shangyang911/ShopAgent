[Unit]
Description=ShopAgent local health state (no notifications)
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/bin/python3 /opt/shopagent/ops/monitor.py --root /opt/shopagent
TimeoutStartSec=4min
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/shopagent/state
StandardOutput=journal
StandardError=journal
