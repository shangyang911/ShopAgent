{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "test": "node --test tests/*.test.mjs",
    "check:architecture": "node scripts/check-architecture.mjs",
    "preview": "vite preview",
    "format": "prettier --write \"src/**/*.{vue,ts,css}\" index.html vite.config.ts",
    "format:check": "prettier --check \"src/**/*.{vue,ts,css}\" index.html vite.config.ts"
  },
  "dependencies": {
    "@amap/amap-jsapi-loader": "^1.0.1",
    "@lucide/vue": "^1.61.0",
    "axios": "^1.20.0",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/tsconfig": "^0.9.1",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vue-tsc": "^3.3.13"
  }
}
